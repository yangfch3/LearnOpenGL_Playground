# 临时文件（探针、中间态）
Temp/

# 各项目指向 shared/ 的目录联接（tools/link-shared.cmd 创建）
**/assets/shared

# 依赖
node_modules/
.venv/
__pycache__/

# 渲染产物（可由源码重新生成，不入库）
renders/
media/
out/
.debug/
.hyperframes/
# 原生 OpenGL 编译产物
pilot/P3-opengl/build/
*.mp4
*.mov
*.webm
*.mkv
*.gif
# HyperFrames 转码缓存
.transcode-cache/
# 由脚本生成的音轨（build.py / music.py 可重建）
pilot/*/assets/sfx/*.wav
pilot/*/assets/bgm/*.wav
